# Copy to apps/web/.env.local and fill in. Never commit real values.
# Local only: production values go to Cloudflare (docs/DEPLOY.md), never in .env files.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: seeds and admin scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouteService (phase 5)
ORS_API_KEY=

# Map tiles style URL, e.g. MapTiler (phase 5)
NEXT_PUBLIC_MAP_STYLE_URL=

# Upstash Redis rate limit and cache (phase 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (phase 7), optional. Events are scrubbed of emails, coordinates and tokens.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Browser errors; usually the same DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Contact shown in the privacy notice (Ley 1581 de 2012). Required before the public launch.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# AI (phase 8)
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACTION=
AI_MODEL_ASSISTANT=
AI_DAILY_LIMIT_EXTRACTIONS=20
AI_DAILY_LIMIT_MESSAGES=50
# Global cap on the estimated AI spend per calendar month, USD.
AI_MONTHLY_BUDGET_USD=50

# E2E only: secret key of a local or test Supabase, so Playwright can create a test user.
# Never the production key. `supabase status` prints the local one.
E2E_SUPABASE_SECRET_KEY=
