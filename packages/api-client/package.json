{
  "name": "@elacharger/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "pnpm --filter @elacharger/schemas openapi \"$PWD/openapi.json\" && openapi-typescript openapi.json -o src/schema.d.ts && prettier --write openapi.json src/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.0"
  }
}
