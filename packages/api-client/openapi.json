{
  "openapi": "3.1.0",
  "info": {
    "title": "Elacharger API",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "Authenticated user that made the request."
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "Server time in UTC."
          }
        },
        "required": ["status", "user_id", "time"]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Unauthorized"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "example": 401
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            },
            "description": "Validation errors, one per invalid field."
          }
        },
        "required": ["type", "title", "status"]
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "enum": ["v1"]
          },
          "server_version": {
            "type": "string",
            "example": "0.1.0"
          },
          "min_client_version": {
            "type": "string",
            "description": "Oldest client version the API still supports.",
            "example": "0.1.0"
          }
        },
        "required": ["api_version", "server_version", "min_client_version"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Authenticated health check",
        "tags": ["system"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The API is up and the token is valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/meta": {
      "get": {
        "summary": "API and client version information",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Version information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
